    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const testId = $json.test_id;\nconst userInput = $json.user_input;\nconst expected = String($json.expected_behavior ?? \"\").trim().toLowerCase();\nconst actual = String($json.output ?? \"\").trim().toLowerCase();\n\nconst passed = actual.includes(expected);\n\nreturn {\n  json: {\n    test_id: testId,\n    user_input: userInput,\n    expected_behavior: $json.expected_behavior,\n    actual_response: $json.output,\n    result: passed ? \"PASS\" : \"FAIL\"\n  }\n};"
      },
