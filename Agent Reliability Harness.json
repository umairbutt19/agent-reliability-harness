      "name": "Loop Over Items"
    },
    {
      "parameters": {
        "jsCode": "const results = $input.all();\n\nconst total = results.length;\n\nconst passed = results.filter(\n  item => item.json.result === \"PASS\"\n).length;\n\nconst failed = results.filter(\n  item => item.json.result === \"FAIL\"\n).length;\n\nconst successRate = total > 0\n  ? Math.round((passed / total) * 100)\n  : 0;\n\nreturn [\n  {\n    json: {\n      total_tests: total,\n      passed: passed,\n      failed: failed,\n      success_rate: `${successRate}%`,\n      overall_status: failed === 0\n        ? \"RELIABLE\"\n        : \"NEEDS IMPROVEMENT\",\n      test_results: results.map(item => item.json)\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1248,
